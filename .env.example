# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=vid_2_vec
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/vid_2_vec?sslmode=disable
DB_SCHEMA=public
DB_MIGRATION_SCHEMA=public
DB_MIGRATION_TABLE=schema_migrations_go

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── App ───────────────────────────────────────────────────────────────────────
APP_PORT=8080
APP_HOST=0.0.0.0

# ── AI ────────────────────────────────────────────────────────────────────────
AI_PROVIDER=google
GOOGLE_AI_KEY=your_google_ai_key_here
GOOGLE_AI_GENERATIVE_MODEL=gemini-2.5-flash
GOOGLE_AI_EMBEDDING_MODEL=gemini-embedding-001
AI_API_MAX_RETRIES=3
AI_API_RETRY_AFTER_DELAY=1000
GOOGLE_AI_FILE_BASE_URI=https://generativelanguage.googleapis.com/v1beta/

# ── Data ──────────────────────────────────────────────────────────────────────
SOURCE_FILE_DIR=/app/data/source

# ── Logging ───────────────────────────────────────────────────────────────────
UPLOADER_LOG_PATH=./logs/uploader.log
STATE_CHECKER_LOG_PATH=./logs/state_checker.log
ANALYZER_LOG_PATH=./logs/analyzer.log
EMBEDDER_LOG_PATH=./logs/embedder.log

# ── Analyzer ──────────────────────────────────────────────────────────────────
ANALYZER_OUTPUT_DIR=/app/data/manifests

# ── Gemini Analysis Prompt ────────────────────────────────────────────────────
GEMINI_ANALYSIS_PROMPT="Analyze this video and return a JSON object with the following fields:\n\nTIMESTAMP RULES (CRITICAL):\nAll timestamps (\"duration\", \"start_time\", \"end_time\") MUST be in SECONDS as plain numbers. Do NOT use MM:SS or M.SS notation. For example, 1 minute 30 seconds = 90 (not 1.30 or 1:30). 5 minutes 50 seconds = 350 (not 5.50 or 5:50). The last scene's \"end_time\" must be close to \"duration\" because both are measured in the same unit (seconds).\n\nVIDEO-LEVEL FIELDS:\n1. \"video_title\": A specific, distinctive title for this video. It MUST be unique enough to distinguish this video from other similar videos. For example, use \"Mama Lin's Garlic Green Beans\" instead of just \"Cooking Tutorial\". Include the creator, subject, or distinguishing detail.\n2. \"video_category\": A high-level genre or category (e.g. \"Cooking Tutorial\", \"Product Review\", \"Travel Vlog\", \"Music Video\").\n3. \"global_keywords\": An array of 3-5 distinctive tags that characterize the whole video (e.g. [\"Vegetarian\", \"Wok\", \"Side Dish\"]). Choose tags that help distinguish this video from others in the same category.\n4. \"duration\": the total video duration in SECONDS as a plain number (e.g. a 5 min 50 sec video = 350). Must be > 0.\n\nSCENE-LEVEL FIELDS:\n5. \"scenes\": an array of scene objects. Each scene MUST have ALL five of these fields populated:\n   - \"start_time\": when the scene begins, in SECONDS (e.g. 90, not 1:30). Must be >= 0.\n   - \"end_time\": when the scene ends, in SECONDS (e.g. 150, not 2:30). Must be > start_time and <= duration.\n   - \"name\": a short descriptive title for the scene (string, 2-6 words, MUST NOT be empty).\n   - \"content\": a factual description of ONLY the visual actions happening in this specific scene, including subjects, settings, and any on-screen text or dialogue (string, at least one full sentence, MUST NOT be empty). Describe what is literally visible, not interpretations. Do NOT include the video title, category, or keywords in this field — those are already captured in the video-level fields above.\n   - \"items\": an array of specific objects, ingredients, tools, or products visible in the scene (e.g. [\"garlic\", \"cutting board\", \"chef's knife\"]). MUST NOT be empty.\n\nIMPORTANT: Every single scene MUST have a non-empty \"name\", a non-empty \"content\", and a non-empty \"items\" array. Do not leave any field as an empty string or empty array."
