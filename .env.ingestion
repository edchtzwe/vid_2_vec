# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_USER=iamatomic
POSTGRES_PASSWORD=ionatom123!
POSTGRES_DB=ion_discovery_proto
POSTGRES_HOST=discovery_engine_db
POSTGRES_PORT=5432
# Add ?sslmode=disable to the end
DATABASE_URL=postgresql://iamatomic:ionatom123!@discovery_engine_db:5432/ion_discovery_proto?sslmode=disable
DB_SCHEMA=discovery_showcase
DB_MIGRATION_SCHEMA=public
DB_MIGRATION_TABLE=schema_migrations_go

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://discovery_engine_redis:6379/0

# ── App ───────────────────────────────────────────────────────────────────────
APP_PORT=8080
APP_HOST=0.0.0.0

# ── AI ─────────────────────────────────────────────────────────────────
AI_PROVIDER=google
GOOGLE_AI_KEY=
GOOGLE_AI_GENERATIVE_MODELS=gemini-2.5-flash,gemini-3-flash-preview
GOOGLE_AI_EMBEDDING_MODEL=gemini-embedding-001
AI_API_MAX_RETRIES=3
AI_API_RETRY_AFTER_DELAY=1000
GOOGLE_AI_FILE_BASE_URI=https://generativelanguage.googleapis.com/v1beta/

# ── Data ──────────────────────────────────────────────────────────────────────
SOURCE_FILE_DIR=/app/data/source

# ── Logging ───────────────────────────────────────────────────────────────────
UPLOADER_LOG_PATH=./logs/uploader.log
STATE_CHECKER_LOG_PATH=./logs/state_checker.log
ANALYZER_LOG_PATH=./logs/analyzer.log
EMBEDDER_LOG_PATH=./logs/embedder.log

# ── Analyzer ──────────────────────────────────────────────────────────────────
ANALYZER_OUTPUT_DIR=/app/data/manifests

# ── Gemini Analysis Prompt ────────────────────────────────────────────────────
GEMINI_ANALYSIS_PROMPT="Analyze this video and return a JSON object.\n\nCRITICAL RULES:\n1. BOUNDARY CHECK: The absolute maximum duration of this video is {{VIDEO_DURATION}} seconds. No scene's \"end_time\" may exceed this. The first scene's \"start_time\" MUST be 0. Max scene length is 30s.\n2. CONTEXT HINT: The user uploaded this file named: \"{{FILE_NAME}}\". Use this to identify the media universe, movie title, and characters. Cross-check visually. If the filename implies a movie (e.g., \"Ip Man 3\") and you see a famous actor (e.g., Mike Tyson), identify them as their CHARACTER in that movie, not their real-world persona.\n3. DUAL-LAYER SPECIFICITY (CRITICAL): You MUST provide both the hyper-specific name AND the broad category. Examples: \"Tyrannosaurus Rex (Dinosaur)\", \"Ford Mustang (Car/Vehicle)\", \"Katana (Sword/Weapon)\". ALWAYS include prominent colors for objects (e.g., \"orange cooler\", \"red jacket\").\n4. CAMERA & CINEMATOGRAPHY: Explicitly describe camera work. If a character makes eye contact with the lens, explicitly write \"looks into the camera\" or \"stares directly at the camera\". Note \"close-up\", \"wide shot\", \"slow motion\".\n5. AUDIO & DIALOGUE: Explicitly state the audio state. If there is no speaking, you MUST write \"No dialogue\" or \"Music only\".\n6. THEMES & TROPES: Identify cinematic tropes and genres in the narrative (e.g., \"Romantic\", \"Supernatural\", \"Comedic/Funny\", \"Dramatic character introduction\", \"Explosion/Action\").\n\nJSON SCHEMA FIELDS (Scene Level):\nInclude \"start_time\", \"end_time\", \"scene_setting\", \"entities_present\" (Format: 'Physical description (Character Name)'), \"action_beats\", \"narrative_description\", \"on_screen_text\", \"camera_and_lighting\", \"audio_and_dialogue\", \"prominent_items\", \"atmosphere\" (2-4 vibe adjectives), \"emotional_state\" (2-4 feeling adjectives), \"clothing_and_fashion\", and \"cinematic_tropes\" (array of strings).\n\nFEW-SHOT EXAMPLES:\n\nExample 1 (Action/Sci-Fi):\n\"scene_setting\": \"City street, daytime\",\n\"entities_present\":[\"Giant green reptile (Tyrannosaurus Rex / Dinosaur)\"],\n\"atmosphere\":[\"Tense\", \"Explosive\"],\n\"emotional_state\":[\"Panic\", \"Fear\"],\n\"action_beats\":[\"T-Rex roars at the sky\", \"Massive fiery explosion destroys a blue Ford Mustang (Car)\"],\n\"camera_and_lighting\":[\"Wide shot\", \"shaky cam\", \"bright daylight\"],\n\"audio_and_dialogue\": \"Deafening explosion, no dialogue\",\n\"prominent_items\":[\"Blue Ford Mustang (Car)\", \"Fire/Explosion\"],\n\"cinematic_tropes\": [\"Action\", \"Disaster\", \"Explosion\"]\n\nExample 2 (Comedy/Romance):\n\"scene_setting\": \"Cozy cafe, evening\",\n\"entities_present\":[\"Man in red sweater (Jack)\", \"Woman in blue dress (Jill)\"],\n\"atmosphere\": [\"Romantic\", \"Humorous\"],\n\"emotional_state\":[\"In love\", \"Embarrassed\"],\n\"action_beats\":[\"Jack spills coffee on his lap\", \"Jill laughs and looks directly into the camera with a smirk\"],\n\"camera_and_lighting\":[\"Close-up on Jill's face\", \"warm lighting\", \"breaks the fourth wall / looks into the camera\"],\n\"audio_and_dialogue\": \"Upbeat jazz music, comedic trombone sound, no dialogue\",\n\"prominent_items\":[\"Orange coffee cooler\", \"Spilled coffee\"],\n\"cinematic_tropes\":[\"Romantic\", \"Comedic/Funny\", \"Fourth Wall Break\"]\n\nExample 3 (Horror/Supernatural):\n\"scene_setting\": \"Dark hallway, midnight\",\n\"entities_present\":[\"Teenage girl in pajamas (Sidney)\", \"Masked figure in black robe (Ghostface)\"],\n\"atmosphere\": [\"Terrifying\", \"Supernatural\", \"Ominous\"],\n\"emotional_state\":[\"State of fear\", \"Absolute Terror\"],\n\"action_beats\":[\"Ghostface suddenly appears from the shadows holding a hunting knife\", \"Sidney screams and runs\"],\n\"camera_and_lighting\":[\"Dutch angle\", \"flickering lights\", \"dramatic character introduction\"],\n\"audio_and_dialogue\": \"High-pitched string music, loud scream\",\n\"prominent_items\":[\"Hunting knife (Weapon)\", \"Ghost mask\"],\n\"cinematic_tropes\":[\"Supernatural\", \"Horror\", \"Dramatic character introduction\", \"Knife holding\"]"